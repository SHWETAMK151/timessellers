# ==============================================================================
# TIMESSELLERS — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to `.env.local` for frontend configuration.
# NEVER put SUPABASE_SERVICE_ROLE_KEY, crypto secret keys, or webhook secrets
# inside any variable prefixed with `VITE_`.
# ==============================================================================

# 1. Public Frontend Supabase Configuration (Safe for Browser with RLS enforced)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key-here

# 2. Optional Custom Edge Function URL Override (defaults to ${VITE_SUPABASE_URL}/functions/v1)
VITE_EDGE_FUNCTIONS_URL=

# ==============================================================================
# SERVER-SIDE ONLY (Supabase Edge Functions Secrets — Set via `supabase secrets set`)
# NEVER expose these in the frontend or commit real values to version control!
# ==============================================================================
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# GATEWAY_FREE_UPI_SECRET=your-shared-secret-between-apps-script-and-supabase
# GATEWAY_FREE_APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXX/exec
# CRYPTO_PROVIDER=nowpayments                  # Supports: nowpayments | coinbase_commerce | cryptomus
# CRYPTO_PROVIDER_API_KEY=your-provider-api-key
# CRYPTO_WEBHOOK_SECRET=your-hmac-webhook-signing-secret
# CRYPTO_IPN_CALLBACK_URL=https://your-project-ref.supabase.co/functions/v1/crypto-webhook
